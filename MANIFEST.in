include README.md
include LICENSE
include CHANGELOG.md
include requirements.txt
include MasterchiefRun.ps1
include MASTER_SETUP.ps1
include CHOCO_PYPI_DEPLOY.ps1
include api_settings.json
include cert_audit.json
include config.yml

# Templates & static assets for web packages
recursive-include tf_wizard/templates *
recursive-include tf_wizard/static *
recursive-include echo/data *.json *.yaml *.txt
recursive-include modules *.tf *.yaml *.yml *.j2 *.json
recursive-include scripts *.sh *.ps1 *.py
recursive-include addons/scripts/templates *
recursive-include config *.yaml *.yml *.json
recursive-include gui *.html *.css *.js
recursive-include templates *.html
recursive-include features/templates *.html
recursive-include managers/data *.json
recursive-include static *.css *.js *.png *.svg *.ico

# Exclude junk
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
global-exclude *.egg-info
prune node_modules
prune data
prune venv
prune test_mc
prune dist
prune build
prune delete
prune .git