_BASE_DIR = Path(__file__).resolve().parent


def _load_feature_flags():

    return load_feature_flags(_BASE_DIR, logger=app.logger)


def _save_feature_flags(flags):

    return save_feature_flags(_BASE_DIR, flags, logger=app.logger)


def _is_feature_enabled(flag_name):

