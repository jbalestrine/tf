# Optional local LLM configuration. Leave blank to use offline study generation.
# Supported endpoints: http://127.0.0.1:11434/api/generate
# or http://127.0.0.1:8000/v1/chat/completions
LLM_ENDPOINT_URL=
LLM_MODEL=
LLM_API_KEY=

# Gmail app password (never commit or share the real .env file).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
EMAIL_KEYWORDS=architect,devops,cloud architect,platform engineer,sre
EMAIL_AUTO_SEND=false
