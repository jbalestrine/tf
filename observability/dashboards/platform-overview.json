{
  "dashboard": {
    "title": "MasterChief Platform Overview",
    "tags": ["masterchief", "devops", "platform"],
    "timezone": "browser",
    "panels": [
      {
        "title": "Platform Health",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"masterchief-platform\"}",
            "legendFormat": "Platform Status"
          }
        ],
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 }
      },
      {
        "title": "HTTP Requests Per Second",
        "type": "graph",
        "targets": [
          {
            "expr": "sum by (endpoint) (rate(masterchief_http_requests_total[5m]))",
            "legendFormat": "{{ endpoint }}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 }
      },
      {
        "title": "Request Latency (p95)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by (le) (rate(masterchief_http_request_duration_seconds_bucket[5m])))",
            "legendFormat": "p95"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 }
      },
      {
        "title": "Server Errors Per Second",
        "type": "graph",
        "targets": [
          {
            "expr": "sum by (endpoint) (rate(masterchief_http_requests_total{status=~\"5..\"}[5m]))",
            "legendFormat": "{{ endpoint }}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 }
      },
      {
        "title": "Requests by HTTP Status",
        "type": "graph",
        "targets": [
          {
            "expr": "sum by (status) (rate(masterchief_http_requests_total[5m]))",
            "legendFormat": "{{ status }}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 }
      }
    ],
    "refresh": "10s",
    "schemaVersion": 30,
    "version": 1
  }
}
